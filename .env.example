# ==============================================================================
# LifeReminder - Environment Configuration Template
# All features in Phase 1-6 run 100% FREE without any credit card or paid services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="LifeReminder"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. MONGODB ATLAS (MANDATORY & 100% FREE TIER)
# Create a free M0 cluster at https://cloud.mongodb.com (512 MB storage, free forever)
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials:
# ------------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lifereminder?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# Generate a secure 32+ character random secret (e.g. `openssl rand -base64 32`)
# ------------------------------------------------------------------------------
JWT_SECRET="replace-with-a-very-long-random-secret-key-at-least-32-chars"
COOKIE_SECRET="another-secure-random-secret-key-for-session-cookies"

# ------------------------------------------------------------------------------
# 4. WHATSAPP ENGINE MODE
# "simulation" = Safe, local, 100% free mode. Messages are logged and previewed
#                in the app UI without invoking Meta APIs or incurring any charges.
# "live"       = Uses official Meta WhatsApp Cloud API (Only switch when authorized).
# ------------------------------------------------------------------------------
WHATSAPP_MODE="simulation"

# ------------------------------------------------------------------------------
# 5. META WHATSAPP CLOUD API (Only required when WHATSAPP_MODE=live)
# Free Tier Note: Meta provides 1,000 free service conversations per month.
# ------------------------------------------------------------------------------
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_WHATSAPP_VERIFY_TOKEN=""
META_APP_SECRET=""

# ------------------------------------------------------------------------------
# 6. AUTOMATIC REMINDER SCHEDULER
# Protects the `/api/internal/process-reminders` endpoint against unauthorized calls.
# An external cron service (like cron-job.org free tier) sends this in the Authorization header.
# ------------------------------------------------------------------------------
CRON_SECRET="generate-a-strong-secret-token-for-cron-scheduler"
