{
  "crons": [
    {
      "path": "/api/internal/process-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "services": {
    "lifereminder": {
      "root": ".",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "lifereminder"
      }
    }
  ]
}
